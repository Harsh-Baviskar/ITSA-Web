# ──────────────────────────────────────────
# ITSA Website — .gitignore
# ──────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/

# Vite cache
.vite/

# Environment files — never commit secrets
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# Editor directories and files
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# TypeScript build info
*.tsbuildinfo

# Optional: local dev notes
scratch.md
TODO.local.md
